{
  "name": "scan-sorter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Put shuffled scans back in order. Find missing pages. Nothing leaves your device.",
  "homepage": "https://scansort.online",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "assets": "node scripts/copy-assets.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
